  "pronoun": "她",
  "belief": "假话",
  "summary": "一句话：她是谁、要什么、卡在哪",
  "asks": [
    {"ask": "他要什么", "lines": [
      {"text": "书里的哪样东西：一个人、一个位置、一处房、一句话；各段换了就各写一行，写明哪一段", "origin": "定", "ref": "编配 对子 甲、乙"}
    ]},
    {"ask": "谁挡着", "lines": [
      {"text": "谁也要它，谁不让她拿", "origin": "盘", "sources": ["E-甲-乙-十神-劫财"]}
    ]},
    {"ask": "他怎么去要", "lines": [
      {"text": "手段；肯做到哪一步", "origin": "盘", "sources": ["T-月干-伤官"]},
      {"text": "不肯做的事", "origin": "盘", "sources": ["T-月干-伤官"]}
    ]},
    {"ask": "他信的那句假话", "lines": [
      {"text": "假话页：一句，和钉下它的那件事。信条页：她拿来过日子的那句话、钉下它的事、谁来挑战、怎么走（被认可、不认、慢慢松、碎）", "origin": "盘", "sources": ["LI-身旺比劫为病-1", "L-6-辛未-冲提纲"]}
    ]},
    {"ask": "他真正缺的", "lines": [
      {"text": "一句", "origin": "盘", "sources": ["U-用-土"]}
    ]},
    {"ask": "碰哪里会疼", "lines": [
      {"line": "怕被分走", "beat": "碰线", "text": "什么事碰到它，底下是什么", "origin": "盘", "sources": ["LI-身旺比劫为病-1"]},
      {"line": "怕被分走", "beat": "身体先动", "text": "情绪先到身上哪里", "origin": "盘", "sources": ["YQ-年-乙丑"]},
      {"line": "怕被分走", "beat": "盖法", "text": "平时拿什么盖住", "origin": "盘", "sources": ["T-月干-伤官"]},
      {"line": "怕被分走", "beat": "破", "by": "别人当面", "text": "盖过几回、碰到什么程度盖不住；谁来破；破了做什么", "origin": "盘", "sources": ["T-月干-伤官"]},
      {"line": "怕被分走", "beat": "余波", "text": "破了以后哪样东西回不去", "origin": "定", "ref": "作者定 某年某月某日"}
    ]},
    {"ask": "他瞒着什么", "lines": []},
    {"ask": "他怎么说话", "lines": [
      {"text": "句式与倾向，不给台词", "origin": "盘", "sources": ["T-月干-伤官", "DM"]}
    ]},
    {"ask": "别人拿他当什么", "lines": [
      {"text": "乙拿她当什么", "origin": "盘", "sources": ["E-乙-甲-十神-劫财"]}
    ]},
    {"ask": "他从哪儿走到哪儿", "lines": [
      {"text": "弧光一句；假话哪一年、被什么样的事打碎，碎了以后按什么行事。信条页写那句话在书里怎么走、别人怎么因她变", "origin": "定", "ref": "编配 前提句"}
    ]},
    {"ask": "他被叫什么", "lines": [
      {"text": "谁叫她什么、她叫谁什么；哪一场改口，改成什么", "origin": "定", "ref": "编配 对子 甲、乙"}
    ]},
    {"ask": "他知道哪一层", "lines": [
      {"text": "她握着哪一层真相（身份、旧账、原本下场），谁比她知道得多，读者站在哪一层", "origin": "定", "ref": "编配 默认下场"}
    ]},
    {"ask": "他信错了谁", "lines": [
      {"text": "她把谁认错了、恨错了、谢错了；哪一样东西递到手上她才认出来", "origin": "定", "ref": "编配 物件账"}
    ]},
    {"ask": "他对谁演什么", "lines": [
      {"text": "对谁演哪一面，对谁不演", "origin": "盘", "sources": ["T-月干-伤官"]}
    ]},
    {"ask": "他独一份的是什么", "lines": [
      {"text": "同一位置上的几个人里，只有她给得了主角的那样东西", "origin": "定", "ref": "编配 人"}
    ]},
    {"ask": "他怎么被记住", "lines": [
      {"text": "标签、反差、一样物件或身体记号；先给哪样", "origin": "盘", "sources": ["T-月干-伤官"]},
      {"text": "一句格言或口头禅，只这一行许带引号：“……”", "origin": "定", "ref": "作者定 某年某月某日"}
    ]}
  ]
}
